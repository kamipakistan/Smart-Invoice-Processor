POSTGRES_DB=fbr_sip_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=secretpassword
DATABASE_URL=postgresql+asyncpg://admin:secretpassword@localhost:5434/fbr_sip_db

REDIS_URL=redis://localhost:6380/0

MINIO_ENDPOINT=localhost:9010
MINIO_EXTERNAL_ENDPOINT=http://localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_BUCKET_RAW=raw-invoices
MINIO_BUCKET_PROCESSED=processed-invoices

# Provider Selection Options: gemini, openai, anthropic, ollama
AI_PROVIDER=gemini

# Gemini Model (Primary Vision AI)
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# OpenAI Model
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=

# Anthropic Model
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=

# Ollama Model
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_HOST=http://localhost:11434

# Groq Model
# - Text: groq/qwen-2.5-32b or groq/qwen-2.5-coder-32b
# - Vision: groq/llama-3.2-11b-vision-preview
GROQ_MODEL=groq/qwen-2.5-32b
GROQ_API_KEY=

# OpenRouter Model
# Options: e.g. google/gemma-4-31b-it:free, openai/gpt-4o, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_API_KEY=

# Ingestion Limits
MAX_UPLOAD_SIZE_MB=25
MAX_BATCH_FILES=200
BATCH_INGESTION_ROOT=/data/ingestion

# Docker Hub Image Repository
BACKEND_IMAGE=kamipakistan/varietyidentification:smartinvoiceprocessor-api-latest
FRONTEND_IMAGE=kamipakistan/varietyidentification:smartinvoiceprocessor-frontend-latest

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:4001
LANGFUSE_PUBLIC_HOST=http://localhost:4001

# Authentication & Security Settings
JWT_SECRET_KEY=changeme-generate-a-real-32-byte-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=true

# Rate Limiting & Account Lockout Settings
LOGIN_RATE_LIMIT="10/minute"
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
